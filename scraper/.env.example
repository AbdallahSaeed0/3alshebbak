# Copy to .env (gitignored) and fill in.

# Who to contact about the scraper; goes in the User-Agent.
SCRAPER_CONTACT=

# TMDB: either a v3 API key or a v4 read access token.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Supabase project (Settings → API). For now this is Pitflix's project; عالشباك's
# tables live in the `shebbak` schema there. The service role key bypasses RLS
# for the WHOLE project, Pitflix's data included: keep it on the scraper's
# machine only, never in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
